pipeline {
    agent any

    parameters {
        choice(
            name: 'MICROSERVICE',
            choices: ['all', 'accounts', 'cards', 'loans', 'configserver', 'eurekaserver', 'gatewayserver', 'message'],
            description: 'Select the microservice to deploy, or "all" to deploy them all together'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'v12',
            description: 'Enter the specific Docker Image Tag you want to deploy (e.g., v12, v15, latest)'
        )
        // You could add environment choices here later (Dev, QA, Prod)
    }

    environment {
        // Defines the list of backend services used when "all" is selected
        ALL_SERVICES = "configserver eurekaserver accounts cards loans gatewayserver message"
    }

    stages {
        stage('Initialize') {
            steps {
                echo "Initializing CD Pipeline for ${params.MICROSERVICE} with image tag ${params.IMAGE_TAG}..."
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    echo "Starting Deployment for: ${params.MICROSERVICE}"
                    
                    withCredentials([file(credentialsId: 'k8s-config', variable: 'KUBECONFIG')]) {
                        if (params.MICROSERVICE == 'all') {
                            def services = env.ALL_SERVICES.split(" ")
                            for (service in services) {
                                echo "=========================================="
                                echo "Deploying ${service}..."
                                sh """
                                helm upgrade --install ${service} ./BankingMS/helm/knightind-services/${service} \
                                  -f ./BankingMS/helm/environments/dev-env/values.yaml \
                                  --set image.tag=${params.IMAGE_TAG} \
                                  --kubeconfig \${KUBECONFIG} \
                                  --wait --timeout 300s
                                """
                            }
                        } else {
                            // Deploy single selected service
                            sh """
                            helm upgrade --install ${params.MICROSERVICE} ./BankingMS/helm/knightind-services/${params.MICROSERVICE} \
                              -f ./BankingMS/helm/environments/dev-env/values.yaml \
                              --set image.tag=${params.IMAGE_TAG} \
                              --kubeconfig \${KUBECONFIG} \
                              --wait --timeout 300s
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
            echo "CD Pipeline finished. Workspace cleaned."
        }
        success {
            echo "SUCCESS: Successfully deployed ${params.MICROSERVICE} version ${params.IMAGE_TAG} to Kubernetes!"
        }
        failure {
            echo "FAILURE: Deployment failed. Please check the logs."
        }
    }
}
